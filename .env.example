# FreeInference PR engineering — environment configuration.
# Copy to .env, fill in the key, and `source .env` before running fi-pr.
# NEVER commit a real .env or any real key value.

# --- FreeInference (required) -------------------------------------------------
# API key from FreeInference (format hyi-...). Required for all inference.
FREEINFERENCE_API_KEY=
# OpenAI-compatible base URL. Do not change unless the provider moves.
FREEINFERENCE_BASE_URL=https://freeinference.org/v1

# --- Per-role models (optional; defaults verified against GET /models) --------
FI_ORCHESTRATOR_MODEL=qwen3.6-35b
FI_ANALYST_MODEL=deepseek-v4-flash
FI_IMPLEMENTER_MODEL=deepseek-v4-flash
FI_REVIEWER_MODEL=qwen3.6-35b
FI_SECURITY_MODEL=qwen3.6-35b
FI_VERIFIER_MODEL=deepseek-v4-flash
FI_INTEGRATION_MODEL=qwen3.6-35b
FI_PACKAGER_MODEL=qwen3.6-35b

# --- Provider capacity & resilience -------------------------------------------
FI_MAX_CONCURRENT=2
FI_REQUEST_TIMEOUT=300
FI_MAX_ATTEMPTS=5
FI_BACKOFF_BASE=1.0
FI_BACKOFF_MAX=30

# --- State & workspaces --------------------------------------------------------
FI_STATE_PATH=state/freeinference-pr.db
FI_WORKSPACE_ROOT=workspaces

# --- Limits, stalls, recovery ---------------------------------------------------
FI_TASK_TIMEOUT=1800
FI_HEARTBEAT_STALE=600
FI_MAX_CORRECTION_CYCLES=3
FI_MAX_AGENT_TURNS=12

# --- GitHub (least privilege) ---------------------------------------------------
# Read-only scope is enough for reviews. Publishing needs contents:write +
# pull-requests:write on the target repository only.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
